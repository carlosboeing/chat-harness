{
  "version": 1,
  "capabilities": {
    "linkedin.job.lookup": {
      "description": "Resolve one public LinkedIn job by numeric job ID using LinkedIn's unauthenticated guest job endpoint.",
      "handler": "capabilities/linkedin-job/handler.mjs",
      "runtime": "node",
      "side_effects": "read-only",
      "timeout_seconds": 15,
      "max_output_chars": 30000,
      "network_policy": {
        "scheme": "https",
        "hosts": [
          "www.linkedin.com",
          "linkedin.com",
          "*.linkedin.com"
        ],
        "request_template": "https://www.linkedin.com/jobs-guest/jobs/api/jobPosting/{job_id}"
      },
      "input": {
        "type": "object",
        "required": [
          "job_id"
        ],
        "properties": {
          "job_id": {
            "type": "string",
            "pattern": "^[0-9]{6,20}$"
          }
        },
        "additionalProperties": false
      }
    },
    "private-health.quote.qch": {
      "description": "Run a read-only synthetic-profile Queensland Country Health Fund quote verification for one allowlisted product combination.",
      "handler": "capabilities/private-health-qch-quote/handler.mjs",
      "runtime": "browser",
      "side_effects": "read-only",
      "timeout_seconds": 90,
      "max_output_chars": 30000,
      "network_policy": {
        "scheme": "https",
        "top_level_hosts": [
          "queenslandcountry.health",
          "www.queenslandcountry.health"
        ],
        "entrypoint": "https://www.queenslandcountry.health/cover-selector-new/"
      },
      "input": {
        "type": "object",
        "required": [
          "profile_ref",
          "hospital_product",
          "extras_product",
          "excess",
          "payment_frequency"
        ],
        "properties": {
          "profile_ref": {
            "type": "string",
            "enum": [
              "synthetic-family-qld-v1"
            ]
          },
          "hospital_product": {
            "type": "string",
            "enum": [
              "Signature Hospital (Silver+)"
            ]
          },
          "extras_product": {
            "type": "string",
            "enum": [
              "Select Extras"
            ]
          },
          "excess": {
            "type": "integer",
            "enum": [
              750
            ]
          },
          "payment_frequency": {
            "type": "string",
            "enum": [
              "monthly"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}\n