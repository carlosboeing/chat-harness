{
  "version": 1,
  "capabilities": {
    "linkedin.job.lookup": {
      "description": "Resolve one public LinkedIn job by numeric job ID using LinkedIn's unauthenticated guest job endpoint.",
      "handler": "capabilities/linkedin-job/handler.ts",
      "runtime": "node",
      "authority": "read-only",
      "timeout_seconds": 15,
      "max_output_chars": 30000,
      "network_policy": {
        "scheme": "https",
        "hosts": [
          "www.linkedin.com",
          "linkedin.com",
          "*.linkedin.com"
        ],
        "request_template": "https://www.linkedin.com/jobs-guest/jobs/api/jobPosting/{job_id}"
      },
      "security": {
        "data_class": "public",
        "credentials": "none",
        "persistent_transport_safe": true
      },
      "input": {
        "type": "object",
        "required": ["job_id"],
        "properties": {
          "job_id": {
            "type": "string",
            "pattern": "^[0-9]{6,20}$"
          }
        },
        "additionalProperties": false
      },
      "lifecycle": "durable",
      "promotion": {
        "basis": "recurring-workflow",
        "evidence": [
          "Work & Career recurring exact LinkedIn job lookup workflow"
        ],
        "reviewed_at": "2026-09-21"
      }
    }
  }
}
