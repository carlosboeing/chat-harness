{
  "name": "chat-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Harness engineering for AI assistants.",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "bun src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-registry.mjs",
    "test": "bun run test:cli && bun run test:legacy",
    "test:cli": "bun test tests/cli tests/setup tests/validation tests/source-policy tests/doctor",
    "test:legacy": "node --test tests/*.test.mjs",
    "smoke:browser": "node scripts/smoke-browser-runtime.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "playwright": "1.63.0",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "7.0.2"
  }
}
