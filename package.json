{
  "name": "chat-harness",
  "version": "0.2.0",
  "private": false,
  "description": "Harness engineering toolkit for long-running work with ChatGPT, Claude, and other AI assistants.",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "cli": "bun src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "validate": "bun scripts/validate-registry.ts",
    "test": "bun run test:cli && bun run test:legacy",
    "test:cli": "bun test tests/cli tests/setup tests/validation tests/source-policy tests/doctor tests/extensions tests/capabilities tests/evals tests/package",
    "test:legacy": "node --test tests/workflow-contract.test.mjs",
    "smoke:browser": "bun scripts/smoke-browser-runtime.ts",
    "validate:docs": "bun scripts/validate-docs.ts",
    "validate:evals": "bun scripts/validate-evals.ts",
    "build:npm": "bun build src/cli/main.ts --target=node --format=esm --packages=bundle --minify --outfile dist/npm/chat-harness.js && bun scripts/prepare-npm.ts",
    "build:binary": "bun scripts/build-binary.ts",
    "checksum": "bun scripts/checksum.ts",
    "validate:package": "bun scripts/validate-package.ts",
    "smoke:npm-package": "bun scripts/smoke-npm-package.ts"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "7.0.2",
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "playwright": "1.63.0",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosboeing/chat-harness.git"
  },
  "homepage": "https://github.com/carlosboeing/chat-harness#readme",
  "bugs": {
    "url": "https://github.com/carlosboeing/chat-harness/issues"
  },
  "keywords": [
    "ai",
    "ai-assistants",
    "chatgpt",
    "claude",
    "harness-engineering",
    "context-engineering",
    "durable-state",
    "agent-harness"
  ],
  "bin": {
    "chat-harness": "dist/npm/chat-harness.js"
  },
  "files": [
    "dist/npm/",
    "README.md",
    "LICENSE",
    "docs/",
    "templates/",
    "schemas/"
  ],
  "publishConfig": {
    "access": "public"
  }
}
