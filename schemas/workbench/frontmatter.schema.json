{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chat-harness.dev/schemas/workbench/frontmatter.schema.json",
  "type": "object",
  "required": ["type", "title", "status", "created", "updated", "workstream"],
  "properties": {
    "type": { "enum": ["idea", "research", "decision", "plan", "review"] },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "approved", "completed", "superseded"] },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "workstream": { "type": "string", "minLength": 1 },
    "supersedes": { "type": "string", "minLength": 1 },
    "superseded_by": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "superseded" } },
        "required": ["status"]
      },
      "then": {
        "required": ["superseded_by"],
        "properties": {
          "superseded_by": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "not": { "const": "superseded" } } },
        "required": ["status"]
      },
      "then": { "not": { "required": ["superseded_by"] } }
    }
  ],
  "additionalProperties": false
}
