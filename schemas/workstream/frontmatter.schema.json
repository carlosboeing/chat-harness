{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chat-harness.dev/schemas/workstream/frontmatter.schema.json",
  "type": "object",
  "required": ["type", "title", "status", "created", "updated"],
  "properties": {
    "type": { "const": "workstream" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "parked", "completed"] },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "additionalProperties": false
}
