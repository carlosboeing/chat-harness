{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chat-harness.dev/schemas/lifecycle/frontmatter.schema.json",
  "type": "object",
  "required": [
    "type",
    "status",
    "created"
  ],
  "properties": {
    "type": {
      "enum": [
        "brainstorm",
        "discovery",
        "design",
        "plan",
        "review",
        "retro",
        "audit"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "completed",
        "superseded"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "superseded_by": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "superseded_by"
        ],
        "properties": {
          "superseded_by": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "superseded"
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "superseded_by"
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
