{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "capability",
    "input"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
