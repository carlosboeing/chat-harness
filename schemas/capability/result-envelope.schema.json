{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "request_id",
    "capability",
    "ok",
    "state",
    "result",
    "error"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "result": {},
    "error": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
